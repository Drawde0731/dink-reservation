# Copy this file to .env and fill in your credentials.
# Never commit .env — it is gitignored.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Cloudflare Turnstile ──────────────────────────────────────────────────────
# SITE key only (public). Secret key goes in Supabase Edge Function secrets.
# Get from: Cloudflare Dashboard → Turnstile → Add site
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# ─── Edge Function secrets (set via Supabase CLI, never in this file) ──────────
# supabase secrets set PAYMONGO_SECRET_KEY=...
# supabase secrets set PAYMONGO_WEBHOOK_SECRET=...
# supabase secrets set RESEND_API_KEY=...
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
