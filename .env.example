# Copy this file to .env and fill in your credentials.
# Never commit .env — it is gitignored.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Cloudflare Turnstile ──────────────────────────────────────────────────────
# SITE key only (public). Secret key is an Edge Function secret (see below).
# Get from: Cloudflare Dashboard → Turnstile → Add site
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# ─── Edge Function secrets ─────────────────────────────────────────────────────
# Set these via Supabase CLI — they are NEVER stored in this file:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set PAYMONGO_SECRET_KEY=sk_live_...
#   supabase secrets set PAYMONGO_WEBHOOK_SECRET_KEY=whsk_...
#   supabase secrets set APP_ORIGIN=https://beanstalldink.com
#   supabase secrets set TURNSTILE_SECRET_KEY=...
#   supabase secrets set TOKEN_ENCRYPTION_KEY=<64 hex chars>
#     (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set RESEND_FROM_EMAIL=Beanstalk Dink <noreply@beanstalldink.com>

# ─── pg_cron Supabase URL (for send-notifications cron job) ───────────────────
# Set these as Postgres settings via Supabase Dashboard → Database → Extensions:
#   ALTER SYSTEM SET app.supabase_url = 'https://your-project-ref.supabase.co';
#   ALTER SYSTEM SET app.service_role_key = 'your-service-role-key';
#   SELECT pg_reload_conf();
